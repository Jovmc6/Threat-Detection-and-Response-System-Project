#include <stdio.h>
#include "platform.h"
#include "xil_io.h"

#define BASE_ADDR 0x43C00000

int main()
{
    init_platform();

    printf("Threat detector AXI test starting...\r\n");

    while (1)
    {
        printf("LOW threat\r\n");
        Xil_Out32(BASE_ADDR + 0x00, 120); // distance
        Xil_Out32(BASE_ADDR + 0x04, 0);   // velocity
        for (volatile int i = 0; i < 10000000; i++);

        printf("MEDIUM threat\r\n");
        Xil_Out32(BASE_ADDR + 0x00, 60);
        Xil_Out32(BASE_ADDR + 0x04, 3);
        for (volatile int i = 0; i < 10000000; i++);

        printf("HIGH threat\r\n");
        Xil_Out32(BASE_ADDR + 0x00, 30);
        Xil_Out32(BASE_ADDR + 0x04, 7);
        for (volatile int i = 0; i < 10000000; i++);
    }

    cleanup_platform();
    return 0;
}
