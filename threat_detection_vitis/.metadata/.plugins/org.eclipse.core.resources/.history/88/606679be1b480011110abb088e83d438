#include <stdio.h>
#include "platform.h"
#include "xgpiops.h"
#include "sleep.h"

#define TRIG_PIN 54   // EMIO GPIO[0]
#define ECHO_PIN 55   // EMIO GPIO[1]

XGpioPs Gpio;

// Measure distance in cm
int measure_distance_cm()
{
    // Send trigger pulse
    XGpioPs_WritePin(&Gpio, TRIG_PIN, 0);
    usleep(5);

    XGpioPs_WritePin(&Gpio, TRIG_PIN, 1);
    usleep(10);
    XGpioPs_WritePin(&Gpio, TRIG_PIN, 0);

    int timeout = 0;

    // Wait for echo HIGH
    while (XGpioPs_ReadPin(&Gpio, ECHO_PIN) == 0)
    {
        usleep(1);
        if (++timeout > 30000)
            return -1; // timeout
    }

    int pulse_us = 0;

    // Measure HIGH pulse width
    while (XGpioPs_ReadPin(&Gpio, ECHO_PIN) == 1)
    {
        usleep(1);
        if (++pulse_us > 30000)
            return -1;
    }

    // Convert to cm
    return pulse_us / 58;
}

int main()
{
    init_platform();

    XGpioPs_Config *ConfigPtr;
    ConfigPtr = XGpioPs_LookupConfig(XPAR_XGPIOPS_0_DEVICE_ID);
    XGpioPs_CfgInitialize(&Gpio, ConfigPtr, ConfigPtr->BaseAddr);

    // TRIG = output
    XGpioPs_SetDirectionPin(&Gpio, TRIG_PIN, 1);
    XGpioPs_SetOutputEnablePin(&Gpio, TRIG_PIN, 1);

    // ECHO = input
    XGpioPs_SetDirectionPin(&Gpio, ECHO_PIN, 0);

    printf("Ultrasonic sensor test starting...\r\n");

    while (1)
    {
        printf("Measuring...\r\n");

        int distance = measure_distance_cm();

        if (distance < 0)
        {
            printf("No echo detected\r\n");
        }
        else
        {
            printf("Distance: %d cm\r\n", distance);
        }

        usleep(500000); // 0.5 sec delay
    }

    cleanup_platform();
    return 0;
}
