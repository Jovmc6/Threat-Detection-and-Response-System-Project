#include <stdio.h>
#include "platform.h"
#include "xgpiops.h"
#include "xil_io.h"
#include "sleep.h"

// AXI base address (from your design)
#define BASE_ADDR 0x43C00000

// EMIO GPIO pins
#define TRIG_PIN 54
#define ECHO_PIN 55

XGpioPs Gpio;

// Measure distance in cm
int measure_distance_cm()
{
    // Send trigger pulse
    XGpioPs_WritePin(&Gpio, TRIG_PIN, 0);
    usleep(5);

    XGpioPs_WritePin(&Gpio, TRIG_PIN, 1);
    usleep(10);
    XGpioPs_WritePin(&Gpio, TRIG_PIN, 0);

    int timeout = 0;

    // Wait for echo HIGH
    while (XGpioPs_ReadPin(&Gpio, ECHO_PIN) == 0)
    {
        usleep(1);
        if (++timeout > 30000)
            return -1;
    }

    int pulse_us = 0;

    // Measure HIGH pulse width
    while (XGpioPs_ReadPin(&Gpio, ECHO_PIN) == 1)
    {
        usleep(1);
        if (++pulse_us > 30000)
            return -1;
    }

    return pulse_us / 58; // convert to cm
}

int main()
{
    init_platform();

    // Initialize GPIO
    XGpioPs_Config *ConfigPtr;
    ConfigPtr = XGpioPs_LookupConfig(XPAR_XGPIOPS_0_DEVICE_ID);
    XGpioPs_CfgInitialize(&Gpio, ConfigPtr, ConfigPtr->BaseAddr);

    // Configure TRIG as output
    XGpioPs_SetDirectionPin(&Gpio, TRIG_PIN, 1);
    XGpioPs_SetOutputEnablePin(&Gpio, TRIG_PIN, 1);

    // Configure ECHO as input
    XGpioPs_SetDirectionPin(&Gpio, ECHO_PIN, 0);

    printf("=== Ultrasonic Threat Detection System ===\r\n");

    int prev_distance = 0;

    while (1)
    {
        int distance = measure_distance_cm();

        if (distance < 0)
        {
            printf("No echo detected\r\n");

            // Safe default
            Xil_Out32(BASE_ADDR + 0x00, 120);
            Xil_Out32(BASE_ADDR + 0x04, 0);
        }
        else
        {
            printf("Distance: %d cm\r\n", distance);

            // Simple velocity estimate
            int velocity = prev_distance - distance;
            if (velocity < 0) velocity = 0;

            printf("Velocity: %d\r\n", velocity);

            // Send to FPGA
            Xil_Out32(BASE_ADDR + 0x00, distance);
            Xil_Out32(BASE_ADDR + 0x04, velocity);

            prev_distance = distance;
        }

        usleep(200000); // 0.2 sec delay
    }

    cleanup_platform();
    return 0;
}
